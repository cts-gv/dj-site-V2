---
import SiteImage from "@/components/SiteImage.astro";
import { siteConfig } from "@/config";

const tags = ["Weddings", "Corporate", "Quinceaneras", "Private Parties", "Festivals"];
---

<section id="about" class="relative py-24 md:py-32 bg-neutral-950 overflow-hidden">
  <div class="absolute top-0 right-0 h-96 w-96 rounded-full bg-violet-500/5 blur-3xl"></div>

  <div class="relative max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
      <!-- Image -->
      <div class="relative order-2 md:order-1">
        <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-violet-500/20 to-pink-500/20 blur-2xl"></div>
        <div class="relative overflow-hidden rounded-3xl shadow-2xl">
          <SiteImage
            src={siteConfig.aboutImage}
            alt={`${siteConfig.djName} DJing at an event`}
            width={900}
            height={600}
            class="w-full h-[400px] md:h-[500px] object-cover transition-transform duration-700 hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent pointer-events-none"></div>
        </div>
        <div class="absolute -bottom-6 -right-2 md:right-8 rounded-2xl bg-gradient-to-br from-violet-500 to-pink-500 px-6 py-4 shadow-xl shadow-violet-500/30">
          <p class="text-3xl font-extrabold text-white">10+</p>
          <p class="text-sm text-white/80">Years Behind the Decks</p>
        </div>
      </div>

      <!-- Text -->
      <div class="order-1 md:order-2">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-violet-400">Get to Know Me</p>
        <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-6 tracking-tight">{siteConfig.aboutTitle}</h2>
        <p class="text-lg text-gray-400 leading-relaxed mb-6">{siteConfig.aboutText}</p>
        <ul class="flex flex-wrap gap-3">
          {tags.map((tag) => (
            <li class="rounded-full border border-violet-500/30 bg-violet-500/10 px-4 py-2 text-sm font-medium text-violet-300">
              {tag}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
