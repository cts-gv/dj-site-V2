---
import { siteConfig } from "@/config";

const areas = siteConfig.serviceAreas;
const areaList = areas.length > 1 ? `${areas.slice(0, -1).join(", ")} and ${areas[areas.length - 1]}` : areas[0];
---

<section id="services" class="relative py-24 md:py-32 bg-neutral-950 overflow-hidden">
  <div class="relative max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-violet-400">Services</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight">DJ Services in {siteConfig.region}</h2>
      <p class="mt-4 text-lg text-gray-400 max-w-2xl mx-auto">
        {siteConfig.djName} plays weddings, quinceaneras, corporate events and private parties across {siteConfig.region}.
        Every booking includes custom playlists, premium sound and lighting, and MC services when you need them.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {siteConfig.services.map((service) => (
        <article class="rounded-2xl border border-white/10 border-l-4 border-l-violet-500 bg-white/5 p-7">
          <h3 class="text-xl font-bold text-white mb-3">{service.title}</h3>
          <p class="text-gray-400 leading-relaxed">{service.text}</p>
        </article>
      ))}
    </div>

    <p class="mt-10 text-center text-gray-400 max-w-3xl mx-auto">
      Serving {areaList}, and surrounding areas.
    </p>
  </div>
</section>
