---
import DjIcon from "@/components/DjIcon.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/config";

const phoneHref = "tel:+1" + siteConfig.phone.replace(/\D/g, "");
const quickLinks = [
  { label: "About", href: "#about" },
  { label: "Services", href: "#services" },
  { label: "Portfolio", href: "#portfolio" },
  { label: "Why Us", href: "#why-us" },
  { label: "Contact", href: "#contact" },
];
const socials = [
  { label: "Instagram", href: siteConfig.instagram, icon: "instagram" },
  { label: "Facebook", href: siteConfig.facebook, icon: "facebook" },
  { label: "TikTok", href: siteConfig.tiktok, icon: "music-2" },
];
const heading = "text-sm font-semibold uppercase tracking-wide text-gray-300 mb-4";
---

<footer class="relative bg-black border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-violet-500 to-pink-500">
            <DjIcon class="h-6 w-6" idSuffix="footer" />
          </span>
          <span class="text-xl font-bold text-white">{siteConfig.djName}</span>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed max-w-xs">
          {siteConfig.tagline}. Professional DJ services for weddings, private parties, quinceaneras, and corporate events
          in {siteConfig.region}.
        </p>
      </div>

      <!-- Quick Links -->
      <nav aria-label="Footer">
        <p class={heading}>Quick Links</p>
        <ul class="space-y-2.5">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-500 hover:text-violet-400 transition-colors text-sm">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact + Social -->
      <div>
        <p class={heading}>Get in Touch</p>
        <ul class="space-y-3">
          <li>
            <a href={phoneHref} class="flex items-center gap-3 text-gray-500 hover:text-violet-400 transition-colors text-sm">
              <Icon name="phone" class="h-4 w-4" />
              {siteConfig.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.email}`} class="flex items-center gap-3 text-gray-500 hover:text-violet-400 transition-colors text-sm">
              <Icon name="mail" class="h-4 w-4" />
              {siteConfig.email}
            </a>
          </li>
        </ul>
        <div class="mt-5 flex items-center gap-3">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-gray-400 hover:text-violet-400 hover:border-violet-500/40 transition-all"
              aria-label={s.label}
            >
              <Icon name={s.icon} class="h-5 w-5" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-gray-600">&copy; {new Date().getFullYear()} {siteConfig.djName}. All rights reserved.</p>
      <p class="flex flex-wrap items-center justify-center gap-1.5 text-sm text-gray-600 text-center leading-relaxed">
        Made with <Icon name="heart" class="h-3.5 w-3.5 text-pink-500 fill-pink-500" /> for music lovers by:
        <a href="https://ctechsolution.tech" target="_blank" rel="noopener noreferrer" class="hover:underline text-gray-700 whitespace-nowrap">
          Community Tech Solutions
        </a>
      </p>
    </div>
  </div>
</footer>
