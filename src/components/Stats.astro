---
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/config";
---

<section id="stats" class="relative py-20 bg-gradient-to-b from-neutral-950 to-black overflow-hidden" aria-labelledby="stats-heading">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(124,92,255,0.10),transparent_70%)]"></div>
  <h2 id="stats-heading" class="sr-only">{siteConfig.djName} by the numbers</h2>

  <div class="relative max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      {siteConfig.stats.map((stat) => (
        <div class="group relative rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm p-6 md:p-8 text-center transition-all hover:border-violet-500/40 hover:bg-white/10 hover:-translate-y-1">
          <div class="mb-4 flex justify-center">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500/20 to-pink-500/20 ring-1 ring-violet-500/30 transition-transform group-hover:scale-110">
              <Icon name={stat.icon} class="h-6 w-6 text-violet-400" />
            </span>
          </div>
          <p class="text-3xl md:text-4xl font-extrabold bg-gradient-to-br from-white to-gray-400 bg-clip-text text-transparent">
            {stat.value}
          </p>
          <p class="mt-2 text-sm md:text-base text-gray-400 font-medium">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
