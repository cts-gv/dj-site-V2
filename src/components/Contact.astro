---
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/config";

const phoneHref = "tel:+1" + siteConfig.phone.replace(/\D/g, "");
const field =
  "w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-white placeholder-gray-600 outline-none transition-colors focus:border-violet-500/60 focus:bg-black/50";
const label = "mb-2 block text-sm font-medium text-gray-300";
---

<section id="contact" class="relative py-24 md:py-32 bg-neutral-950 overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 h-96 w-96 rounded-full bg-violet-500/10 blur-3xl"></div>

  <div class="relative max-w-3xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-violet-400">Let's Party</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight">Book Your Event</h2>
      <p class="mt-4 text-lg text-gray-400">
        Tell us about your celebration and we'll get back to you within 24 hours.
      </p>
      <p class="mt-3 text-gray-400">
        Prefer to talk? Call <a href={phoneHref} class="font-semibold text-violet-300 hover:text-violet-200">{siteConfig.phone}</a>
        or email <a href={`mailto:${siteConfig.email}`} class="font-semibold text-violet-300 hover:text-violet-200">{siteConfig.email}</a>.
      </p>
    </div>

    <div class="rounded-3xl border border-white/10 bg-white/5 backdrop-blur-sm p-6 md:p-10 shadow-2xl">
      <!-- Success message (shown by the script below after Formspree accepts the request) -->
      <div id="form-success" class="hidden flex-col items-center text-center py-10" role="status">
        <Icon name="circle-check" class="h-16 w-16 text-green-500 mb-4" />
        <h3 class="text-2xl font-bold text-white mb-2">Request Received!</h3>
        <p class="text-gray-400 max-w-md">
          Thanks for reaching out! We'll be in touch within 24 hours to plan your event.
        </p>
        <button
          type="button"
          id="form-reset"
          class="mt-6 rounded-full border border-white/20 px-6 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
        >
          Send Another Request
        </button>
      </div>

      <!-- Works without JavaScript too: the browser posts straight to Formspree. -->
      <form id="booking-form" action={siteConfig.formspreeEndpoint} data-endpoint={siteConfig.formspreeEndpoint} method="POST" class="space-y-5">
        <input type="hidden" name="_subject" value={`New booking request - ${siteConfig.djName}`} />
        <!-- Spam trap: real visitors never see or fill this in -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="f-name" class={label}>Full Name *</label>
            <input id="f-name" type="text" name="name" required autocomplete="name" class={field} placeholder="Jane Doe" />
          </div>
          <div>
            <label for="f-email" class={label}>Email *</label>
            <input id="f-email" type="email" name="email" required autocomplete="email" class={field} placeholder="jane@email.com" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="f-phone" class={label}>Phone</label>
            <input id="f-phone" type="tel" name="phone" autocomplete="tel" class={field} placeholder="(555) 123-4567" />
          </div>
          <div>
            <label for="f-type" class={label}>Event Type *</label>
            <select id="f-type" name="eventType" required class={field.replace("placeholder-gray-600 ", "")}>
              <option value="" class="bg-neutral-900">Select type...</option>
              {siteConfig.eventTypes.map((type) => (
                <option value={type} class="bg-neutral-900">{type}</option>
              ))}
            </select>
          </div>
        </div>

        <div>
          <label for="f-date" class={label}>Preferred Event Date</label>
          <input id="f-date" type="date" name="eventDate" class={`${field} [color-scheme:dark]`} />
        </div>

        <div>
          <label for="f-message" class={label}>Tell us about your event</label>
          <textarea
            id="f-message"
            name="message"
            rows="4"
            class={`${field} resize-none`}
            placeholder="Venue, number of guests, music preferences, special requests..."
          ></textarea>
        </div>

        <div id="form-error" class="hidden items-center gap-3 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3" role="alert">
          <Icon name="circle-alert" class="h-5 w-5 text-red-400 flex-shrink-0" />
          <p id="form-error-text" class="text-sm text-red-300"></p>
        </div>

        <button
          type="submit"
          id="form-submit"
          class="w-full inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-violet-500 to-pink-500 px-8 py-4 text-base font-bold text-white shadow-xl shadow-violet-500/30 transition-all hover:scale-[1.02] hover:shadow-violet-500/50 disabled:opacity-60 disabled:hover:scale-100"
        >
          <span id="submit-idle" class="inline-flex items-center gap-2"><Icon name="send" class="h-5 w-5" /> Send Booking Request</span>
          <span id="submit-busy" class="hidden items-center gap-2"><Icon name="loader-circle" class="h-5 w-5 animate-spin" /> Sending...</span>
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("booking-form") as HTMLFormElement | null;
  const success = document.getElementById("form-success")!;
  const errorBox = document.getElementById("form-error")!;
  const errorText = document.getElementById("form-error-text")!;
  const submit = document.getElementById("form-submit") as HTMLButtonElement;
  const idle = document.getElementById("submit-idle")!;
  const busy = document.getElementById("submit-busy")!;

  const show = (el: HTMLElement, on: boolean, display = "flex") => {
    el.classList.toggle("hidden", !on);
    el.classList.toggle(display, on);
  };
  const showError = (msg: string) => {
    errorText.textContent = msg;
    show(errorBox, true);
  };
  const setBusy = (on: boolean) => {
    submit.disabled = on;
    show(idle, !on, "inline-flex");
    show(busy, on, "inline-flex");
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    show(errorBox, false);

    const endpoint = form.dataset.endpoint ?? "";
    if (!endpoint || endpoint.includes("YOUR_FORM_ID")) {
      showError("The booking form isn't connected yet. Please call or email instead.");
      return;
    }

    setBusy(true);
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (res.ok) {
        form.reset();
        show(form, false);
        show(success, true);
      } else {
        const data = await res.json().catch(() => ({}));
        const msg = Array.isArray(data?.errors)
          ? data.errors.map((x: { message?: string }) => x.message).filter(Boolean).join(", ")
          : "";
        showError(msg || "Something went wrong. Please try again.");
      }
    } catch {
      showError("Couldn't reach the server. Check your connection and try again.");
    } finally {
      setBusy(false);
    }
  });

  document.getElementById("form-reset")?.addEventListener("click", () => {
    show(success, false);
    if (form) show(form, true, "block");
  });
</script>
