---
/*
 * DJ icon: converted from the CSS-art DJ into a reusable SVG.
 * Figure is white; turntable details are dark so it reads on the violet-to-pink badge.
 * `idSuffix` keeps the clipPath id unique when the icon is used more than once on a page.
 */
interface Props {
  class?: string;
  idSuffix?: string;
}
const { class: className = "", idSuffix = "a" } = Astro.props;
const clip = `dj-band-${idSuffix}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="140 40 290 380"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <defs><clipPath id={clip}><polygon points="294,158 94,-42 494,-42"></polygon></clipPath></defs>
  <path clip-path={`url(#${clip})`} fill="#fff" fill-rule="evenodd" d="M186 257a108 207 0 1 0 216 0a108 207 0 1 0 -216 0Z M201 257a93 192 0 1 0 186 0a93 192 0 1 0 -186 0Z"></path>
  <rect x="248" y="80" width="93" height="100" rx="28" ry="30" fill="#fff"></rect>
  <path d="M199.1 123 a23.25 38.4 0 0 1 23.25 -38.4 H245.6 V161.4 H222.35 a23.25 38.4 0 0 1 -23.25 -38.4Z" fill="#fff"></path>
  <path d="M343.3 88 H366.55 a23.25 38.4 0 0 1 0 76.8 H343.3Z" fill="#fff"></path>
  <rect x="248" y="192" width="93" height="112" fill="#fff"></rect>
  <rect x="217.0" y="140.0" width="31.0" height="120.0" rx="15.5" transform="rotate(-60 232.5 200.0)" fill="#fff"></rect>
  <rect x="161.2" y="88.0" width="31.0" height="100.0" rx="15.5" transform="rotate(-15 176.7 138.0)" fill="#fff"></rect>
  <rect x="359.6" y="176.0" width="31.0" height="120.0" rx="15.5" transform="rotate(-50 375.1 236.0)" fill="#fff"></rect>
  <rect x="366.0" y="244.0" width="37.0" height="106.0" rx="18.5" transform="rotate(45 384.5 297.0)" fill="#fff" stroke="#14080f" stroke-width="3"></rect>
  <rect x="217" y="312" width="155" height="100" fill="#fff"></rect>
  <ellipse cx="359.6" cy="362" rx="7.75" ry="5" fill="#14080f"></ellipse><ellipse cx="359.6" cy="382" rx="7.75" ry="5" fill="#14080f"></ellipse>
  <ellipse cx="302.25" cy="359" rx="46.5" ry="45" fill="#14080f"></ellipse><ellipse cx="302.25" cy="359" rx="40.4" ry="39.2" fill="#fff"></ellipse><ellipse cx="302.25" cy="359" rx="9.3" ry="9" fill="#14080f"></ellipse>
  <rect x="240.2" y="380.0" width="38.8" height="10.0" rx="5.0" transform="rotate(-35 259.6 385.0)" fill="#14080f"></rect>
  <ellipse cx="277.4" cy="372" rx="6.2" ry="10" transform="rotate(-30 277.4 372)" fill="#14080f"></ellipse>
</svg>
