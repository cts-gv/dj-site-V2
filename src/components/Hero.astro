---
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/config";
---

<section id="hero" class="relative h-screen min-h-[600px] w-full overflow-hidden">
  <!-- Background. The poster image is always there (no flash of black, and it is what shows if video is
       not allowed). The video is downloaded while the splash screen is up, starts the moment the splash
       has gone, and fades in over the poster. See the script below. -->
  <img
    src={siteConfig.heroPosterImage}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover"
    decoding="async"
  />
  <video
    id="hero-video"
    class="absolute inset-0 h-full w-full object-cover"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    data-src={siteConfig.heroVideoUrl}
  >
  </video>

  <!-- Gradient overlays -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/90"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>

  <!-- Animated glow orbs -->
  <div class="absolute top-1/4 left-1/4 h-72 w-72 rounded-full bg-violet-500/20 blur-3xl animate-pulse"></div>
  <div class="absolute bottom-1/4 right-1/4 h-96 w-96 rounded-full bg-pink-500/15 blur-3xl animate-pulse [animation-delay:1s]"></div>

  <!-- Content -->
  <div class="relative z-10 flex h-full flex-col items-center justify-center text-center px-6">
    <div class="w-full max-w-3xl">
      <p class="hero-fade-in mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-violet-400">
        {siteConfig.slogan}
      </p>

      <!-- The name is a drawn-on SVG; the h1 text is real text for screen readers and search engines. -->
      <h1 class="draw-logo mx-auto w-full max-w-[640px]">
        <span class="sr-only">{siteConfig.djName}: wedding and event DJ serving {siteConfig.region}</span>
        <svg viewBox="0 0 700 240" aria-hidden="true">
          <rect class="border-rect" x="20" y="20" width="660" height="200" rx="10" ry="10"></rect>
          <text x="50%" y="54%" text-anchor="middle" dominant-baseline="middle">{siteConfig.djName}</text>
        </svg>
      </h1>

      <p class="hero-fade-in mt-6 text-xl sm:text-2xl md:text-3xl font-light text-gray-200 drop-shadow-lg">
        {siteConfig.tagline}
      </p>
      <p class="hero-fade-in mx-auto mt-4 max-w-xl text-base sm:text-lg text-gray-300">
        Professional DJ for weddings, quinceaneras, corporate events and private parties in {siteConfig.region}
      </p>

      <div class="hero-fade-in mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#contact"
          class="w-full sm:w-auto rounded-full bg-gradient-to-r from-violet-500 to-pink-500 px-8 py-4 text-base font-bold text-white shadow-xl shadow-violet-500/40 transition-all hover:scale-105 hover:shadow-violet-500/60"
        >
          Book Your Event
        </a>
        <a
          href="#portfolio"
          class="w-full sm:w-auto rounded-full border-2 border-white/30 bg-white/5 backdrop-blur-sm px-8 py-4 text-base font-bold text-white transition-all hover:bg-white/15 hover:border-white/50"
        >
          View Portfolio
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a
    href="#about"
    class="hero-fade-in absolute bottom-8 left-1/2 -translate-x-1/2 text-white/60 hover:text-white transition-colors animate-bounce"
    aria-label="Scroll down"
  >
    <Icon name="chevron-down" class="h-8 w-8" />
  </a>
</section>

<style>
  #hero-video { opacity: 0; transition: opacity 1s ease; }
  #hero-video.is-playing { opacity: 1; }
</style>

<script>
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;
  const root = document.documentElement;
  let attached = false;

  // No video for visitors on data saver or who prefer reduced motion: they keep the poster image.
  const allowed = () => {
    const saveData = (navigator as unknown as { connection?: { saveData?: boolean } }).connection?.saveData;
    return !saveData && !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  };

  // Starts the download (and nothing else).
  const attach = () => {
    if (attached || !video || !video.dataset.src || !allowed()) return;
    attached = true;
    video.preload = "auto";
    const source = document.createElement("source");
    source.src = video.dataset.src;
    source.type = "video/mp4";
    video.appendChild(source);
    video.load();
  };

  const play = () => {
    attach();
    if (attached) video?.play().catch(() => {});
  };

  video?.addEventListener("playing", () => video.classList.add("is-playing"), { once: true });

  if (!root.classList.contains("splash-pending")) {
    play();
  } else {
    // The splash is on screen for a few seconds: use that time to download the video, so it can
    // start the instant the splash is gone. (Waiting until the splash had finished is what made
    // the poster show for a while.)
    const early = () => window.setTimeout(attach, 300);
    if (document.readyState === "complete") early();
    else window.addEventListener("load", early, { once: true });

    const mo = new MutationObserver(() => {
      if (!root.classList.contains("splash-pending")) {
        mo.disconnect();
        play();
      }
    });
    mo.observe(root, { attributes: true, attributeFilter: ["class"] });
  }
</script>
