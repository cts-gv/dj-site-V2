---
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/config";
---

<section id="why-us" class="relative py-24 md:py-32 bg-gradient-to-b from-black to-neutral-950 overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(236,72,153,0.06),transparent_60%)]"></div>

  <div class="relative max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-violet-400">Why Choose Us</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight">The DJ-Mando Difference</h2>
      <p class="mt-4 text-lg text-gray-400 max-w-2xl mx-auto">
        More than just playing songs — we deliver a complete entertainment experience.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {siteConfig.whyUs.map((item) => (
        <div class="group relative rounded-2xl border border-white/10 bg-white/5 p-7 transition-all hover:border-violet-500/40 hover:bg-white/10 hover:-translate-y-1">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-500/20 to-pink-500/20 ring-1 ring-violet-500/30 transition-transform group-hover:scale-110 group-hover:rotate-3">
            <Icon name={item.icon} class="h-7 w-7 text-violet-400" />
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
          <p class="text-gray-400 leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
