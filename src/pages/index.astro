---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Hero from "@/components/Hero.astro";
import About from "@/components/About.astro";
import Stats from "@/components/Stats.astro";
import Services from "@/components/Services.astro";
import Portfolio from "@/components/Portfolio.astro";
import WhyUs from "@/components/WhyUs.astro";
import Contact from "@/components/Contact.astro";
import Footer from "@/components/Footer.astro";
import Splash from "@/components/islands/Splash";
import MusicDock from "@/components/islands/MusicDock";
---

<Layout splash>
  <!-- All page content is plain HTML, present on first load. -->
  <div id="page" class="min-h-screen bg-black text-white antialiased">
    <Navbar />
    <main>
      <Hero />
      <About />
      <Stats />
      <Services />
      <Portfolio />
      <WhyUs />
      <Contact />
    </main>
    <Footer />
  </div>

  <!-- Interactive extras (client-side only): the entry splash overlay and the bottom music dock. -->
  <Splash client:only="react" />
  <MusicDock client:only="react" />
</Layout>
